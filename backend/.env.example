LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENT_CALLS=4
MAX_CONCURRENT_EVALUATION_JOBS=1
THREADLINE_DATABASE_PATH=./data/threadline.db
THREADLINE_EXPORT_DIRECTORY=./data/exports
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_RECORDS_PER_REQUEST=250
MAX_RECORD_TEXT_CHARACTERS=20000
MAX_TOTAL_REQUEST_CHARACTERS=1000000
MAX_CANDIDATES_PER_RECORD=10
MAX_BENCHMARK_IDENTITIES=500

# Legacy THREADLINE_PROVIDER_MODE / THREADLINE_OPENAI_* names remain supported.
